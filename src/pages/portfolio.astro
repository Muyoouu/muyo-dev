---
import { getCollection } from 'astro:content'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import BaseLayout from '../layouts/BaseLayout.astro'

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order)
---

<BaseLayout
  title="Portfolio — Musa Yohanes"
  description="Selected projects by Musa Yohanes, from SaaS platforms to finance automation and data work."
>
  <Header />
  <main class="flex-1">
    <section>
      <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
        <h1 class="text-4xl font-bold tracking-tight text-foreground md:text-5xl">
          Portfolio
        </h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground">
          Selected projects across SaaS, workflow automation, data, and finance
          systems.
        </p>
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {
            projects.map((project) => (
              <article class="flex flex-col border border-border bg-card p-6 transition-colors duration-200 hover:border-accent">
                <div class="flex items-start justify-between gap-4">
                  <h2 class="text-lg font-semibold text-foreground">
                    <a
                      href={`/projects/${project.id}/`}
                      class="transition-colors duration-200 hover:text-accent"
                    >
                      {project.data.title}
                    </a>
                  </h2>
                  {project.data.url && (
                    <a
                      href={project.data.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Visit ${project.data.title}`}
                      class="mt-0.5 shrink-0 text-muted-foreground transition-colors duration-200 hover:text-accent"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M15 3h6v6" />
                        <path d="M10 14 21 3" />
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      </svg>
                    </a>
                  )}
                </div>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">
                  {project.data.description}
                </p>
                <ul class="mt-5 flex flex-wrap gap-2">
                  {project.data.tags.map((tag) => (
                    <li class="border border-border px-2 py-0.5 text-xs font-medium text-muted-foreground">
                      {tag}
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
