---
import { getCollection } from 'astro:content'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import SpecCard from '../components/SpecCard.astro'
import BaseLayout from '../layouts/BaseLayout.astro'

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order)
---

<BaseLayout
  title="Portfolio · Musa Yohanes"
  description="Selected projects by Musa Yohanes, from SaaS platforms to finance automation and data work."
>
  <Header />
  <main id="main" class="flex-1">
    <section>
      <div class="mx-auto max-w-[1240px] px-6 py-16 md:py-20">
        <div class="section-head">
          <span class="font-mono text-sm font-semibold text-accent">00</span>
          <h1 class="text-3xl font-semibold tracking-tight text-foreground md:text-4xl">Catalog</h1>
        </div>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-secondary">
          Every component I've shipped, oldest lessons included. The older case
          studies stay as written: they show the path, not just where it ended.
          Hover, focus, or tap the spec control to flip a package over.
        </p>
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {projects.map((project) => <SpecCard project={project} />)}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
