---
import { getCollection } from 'astro:content'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import SpecCard from '../components/SpecCard.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { sortProjectsByOrder } from '../lib/projects'

const projects = sortProjectsByOrder(await getCollection('projects'))
---

<BaseLayout
  title="Portfolio · Musa Yohanes"
  description="Case studies by Musa Yohanes across B2B data platforms, finance automation, and data analysis."
>
  <Header />
  <main id="main" class="flex-1">
    <section>
      <div class="mx-auto max-w-[1240px] px-6 py-16 md:py-20">
        <div class="section-head">
          <span class="font-mono text-sm font-semibold text-accent">00</span>
          <h1 class="text-3xl font-semibold tracking-tight text-foreground md:text-4xl">Catalog</h1>
        </div>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-secondary">
          Case studies, left as they were written. They show the path I took,
          not the tidied-up version.
        </p>
        {
          projects.length > 0 && (
            <div class="mt-12 grid gap-6 md:grid-cols-2">
              {projects.map((project) => <SpecCard project={project} />)}
            </div>
          )
        }
        {
          projects.length === 0 ? (
            <p class="mt-12 border-y border-border py-7 text-secondary">
              No case studies published yet.
            </p>
          ) : (
            <p class="mt-6 font-mono text-xs leading-relaxed text-secondary">
              Spec flips a card for its stack and role.
            </p>
          )
        }
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
