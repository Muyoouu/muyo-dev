---
import { getCollection } from 'astro:content'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import SpecCard from '../components/SpecCard.astro'
import { profile } from '../data/profile'
import BaseLayout from '../layouts/BaseLayout.astro'
import { sortPostsDesc } from '../lib/writing'

const featuredProjects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3)

const latestPosts = sortPostsDesc(await getCollection('writing')).slice(0, 3)

const { experience, certifications, socials } = profile

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })

const ratings = [
  { param: 'Years in finance work', rating: '3' },
  { param: 'PwC assurance', rating: 'Done' },
  { param: 'SaaS products shipped', rating: '1' },
  { param: 'Bike trips analyzed', rating: '3.5M' },
  { param: 'OAuth2 flows from scratch', rating: '1' },
  { param: 'Token cache validity', rating: '60 days' },
]
---

<BaseLayout title={profile.site.title} description={profile.site.description}>
  <Header />
  <main id="main" class="flex-1">
    <!-- Sheet cover: drawing frame, title block row, features and ratings -->
    <section class="mx-auto max-w-[1240px] px-6 pt-8">
      <div class="border-2 border-foreground">
        <div class="grid grid-cols-2 border-b-2 border-foreground md:grid-cols-4">
          <div class="border-r border-border px-5 py-3 max-md:[&:nth-child(2)]:border-r-0">
            <p class="mono-label text-secondary">Title</p>
            <p class="mt-1 text-sm font-semibold uppercase tracking-tight text-foreground">
              Software Developer
            </p>
          </div>
          <div class="border-border px-5 py-3 md:border-r">
            <p class="mono-label text-secondary">Drawn by</p>
            <p class="mt-1 text-sm font-semibold uppercase tracking-tight text-foreground">
              Musa Yohanes
            </p>
          </div>
          <div class="border-r border-border px-5 py-3 max-md:[&:nth-child(3)]:border-t max-md:[&:nth-child(3)]:border-border">
            <p class="mono-label text-secondary">Location</p>
            <p class="mt-1 text-sm font-semibold uppercase tracking-tight text-foreground">
              Jakarta, ID
            </p>
          </div>
          <div class="border-border px-5 py-3 max-md:[&:nth-child(4)]:border-t max-md:[&:nth-child(4)]:border-border">
            <p class="mono-label text-secondary">Rev</p>
            <p class="mt-1 font-mono text-sm font-semibold text-accent tabular-nums">2026&middot;A</p>
          </div>
        </div>

        <div class="grid md:grid-cols-[7fr_5fr]">
          <div class="border-b-2 border-foreground p-8 md:border-b-0 md:border-r-2 md:p-12">
            <p class="mono-label text-accent">Features</p>
            <h1 class="hero-display mt-4 text-foreground">
              I used to check the numbers.
              <span class="block text-accent">Now I build the systems that move them.</span>
            </h1>
            <p class="mt-6 max-w-xl text-lg leading-relaxed text-secondary">
              I'm Musa. I build data platforms for treasury teams at a Dutch
              SaaS company, remote from Jakarta. Before that I audited
              financials at PwC and taught accounting, so I know both sides of
              the numbers I now move.
            </p>
            <div class="mt-10 flex flex-wrap gap-3">
              <a
                href="/portfolio"
                class="mono-label inline-flex items-center bg-accent-fill px-6 py-3.5 text-white transition-colors duration-200 hover:bg-accent-fill-hover"
              >
                See the work
              </a>
              <a
                href="/blog"
                class="mono-label inline-flex items-center border-2 border-foreground px-6 py-3.5 text-foreground transition-colors duration-200 hover:border-accent hover:text-accent"
              >
                Read my writing
              </a>
            </div>
          </div>

          <div class="p-8 md:p-12 md:py-12">
            <p class="mono-label text-secondary">Absolute maximum ratings</p>
            <table class="mt-4 w-full border-collapse text-sm">
              <thead>
                <tr class="border-b border-border text-left">
                  <th scope="col" class="mono-label py-2 pr-4 font-medium text-secondary">Parameter</th>
                  <th scope="col" class="mono-label py-2 text-right font-medium text-secondary">Rating</th>
                </tr>
              </thead>
              <tbody>
                {
                  ratings.map((row) => (
                    <tr class="border-b border-border last:border-b-0">
                      <td class="py-2.5 pr-4 text-foreground">{row.param}</td>
                      <td class="py-2.5 text-right font-mono font-medium text-accent tabular-nums">
                        {row.rating}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
            <p class="mt-4 font-mono text-[11px] leading-relaxed text-secondary">
              * Every rating above is on the record. No fabrication, no
              rounding up.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 01 Applications -->
    <section class="mx-auto max-w-[1240px] px-6 py-16 md:py-20">
      <div class="section-head">
        <span class="font-mono text-sm font-semibold text-accent">01</span>
        <h2 class="text-2xl font-semibold tracking-tight text-foreground md:text-3xl">Applications</h2>
        <a
          href="/portfolio"
          class="mono-label ml-auto text-secondary transition-colors duration-200 hover:text-accent"
        >
          Full catalog
        </a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {featuredProjects.map((project) => <SpecCard project={project} featured />)}
      </div>
    </section>

    <!-- 02 Publications -->
    <section class="border-y-2 border-foreground">
      <div class="mx-auto max-w-[1240px] px-6 py-16 md:py-20">
        <div class="section-head border-t-0 pt-0">
          <span class="font-mono text-sm font-semibold text-accent">02</span>
          <h2 class="text-2xl font-semibold tracking-tight text-foreground md:text-3xl">Publications</h2>
          <a
            href="/blog"
            class="mono-label ml-auto text-secondary transition-colors duration-200 hover:text-accent"
          >
            All writing
          </a>
        </div>
        <ul class="mt-10 divide-y divide-border border-y border-border">
          {
            latestPosts.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`} class="group block py-6">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                    <h3 class="text-lg font-medium tracking-tight text-foreground transition-colors duration-200 group-hover:text-accent">
                      {post.data.title}
                    </h3>
                    <time
                      datetime={post.data.pubDate.toISOString()}
                      class="font-mono text-xs text-secondary tabular-nums"
                    >
                      {formatDate(post.data.pubDate)}
                    </time>
                  </div>
                  <p class="mt-2 max-w-2xl text-[15px] leading-relaxed text-secondary">
                    {post.data.description}
                  </p>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 03 Record -->
    <section class="mx-auto max-w-[1240px] px-6 py-16 md:py-20">
      <div class="section-head">
        <span class="font-mono text-sm font-semibold text-accent">03</span>
        <h2 class="text-2xl font-semibold tracking-tight text-foreground md:text-3xl">Record</h2>
        <a
          href="/about"
          class="mono-label ml-auto text-secondary transition-colors duration-200 hover:text-accent"
        >
          Full background
        </a>
      </div>
      <div class="mt-10 grid gap-12 md:grid-cols-2">
        <div>
          <ol class="divide-y divide-border border-y border-border">
            {
              experience.map((job) => (
                <li class="py-5">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                    <h3 class="font-medium text-foreground">
                      {job.role} &middot; {job.company}
                    </h3>
                    <p class="font-mono text-xs text-secondary tabular-nums">{job.period}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        <div>
          <ul class="divide-y divide-border border-y border-border">
            {
              certifications.map((cert) => (
                <li class="flex items-baseline justify-between gap-4 py-4 text-[15px] font-medium text-foreground">
                  {cert}
                  <span class="mono-label shrink-0 text-secondary" aria-hidden="true">Cert</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- 04 Operator -->
    <section class="border-t-2 border-foreground">
      <div class="mx-auto max-w-[1240px] px-6 py-20 md:py-24">
        <div class="section-head border-t-0 pt-0">
          <span class="font-mono text-sm font-semibold text-accent">04</span>
          <h2 class="text-2xl font-semibold tracking-tight text-foreground md:text-3xl">Operator</h2>
        </div>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-secondary">
          Got a project in mind, a dataset that fights back, or a question
          about moving between finance and software? I can help. Email works
          best, and I answer everything.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={`mailto:${socials.email}`}
            class="mono-label inline-flex items-center bg-accent-fill px-6 py-3.5 text-white transition-colors duration-200 hover:bg-accent-fill-hover"
          >
            Email me
          </a>
          <a
            href={socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="mono-label inline-flex items-center border-2 border-foreground px-6 py-3.5 text-foreground transition-colors duration-200 hover:border-accent hover:text-accent"
          >
            LinkedIn
          </a>
          <a
            href={socials.github}
            target="_blank"
            rel="noopener noreferrer"
            class="mono-label inline-flex items-center border-2 border-foreground px-6 py-3.5 text-foreground transition-colors duration-200 hover:border-accent hover:text-accent"
          >
            GitHub
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
