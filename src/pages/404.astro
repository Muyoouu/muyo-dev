---
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="404 · Page not found"
  description="The page you are looking for does not exist."
>
  <Header />
  <main class="flex flex-1 items-center justify-center">
    <div class="mx-auto w-full max-w-[1240px] px-6 py-24">
      <div class="border-2 border-foreground">
        <div class="grid grid-cols-2 border-b-2 border-foreground md:grid-cols-4">
          <div class="border-r border-border px-5 py-3 max-md:[&:nth-child(2)]:border-r-0">
            <p class="mono-label text-secondary">Error</p>
            <p class="mt-1 font-mono text-sm font-semibold text-accent">404</p>
          </div>
          <div class="border-border px-5 py-3 md:border-r">
            <p class="mono-label text-secondary">Cause</p>
            <p class="mt-1 text-sm font-semibold text-foreground">Sheet not found</p>
          </div>
          <div class="border-r border-border px-5 py-3 max-md:[&:nth-child(3)]:border-t max-md:[&:nth-child(3)]:border-border">
            <p class="mono-label text-secondary">Recovery</p>
            <p class="mt-1 text-sm font-semibold text-foreground">Use the links below</p>
          </div>
          <div class="border-border px-5 py-3 max-md:[&:nth-child(4)]:border-t max-md:[&:nth-child(4)]:border-border">
            <p class="mono-label text-secondary">Severity</p>
            <p class="mt-1 text-sm font-semibold text-foreground">Cosmetic</p>
          </div>
        </div>
        <div class="p-8 md:p-12">
          <h1 class="hero-display text-foreground">This sheet doesn't exist.</h1>
          <p class="mt-4 max-w-md text-lg leading-relaxed text-secondary">
            The URL points at a page that was never drawn. Everything that
            does exist is one click away.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="/"
              class="mono-label inline-flex items-center bg-accent-fill px-6 py-3.5 text-white transition-colors duration-200 hover:bg-accent-fill-hover"
            >
              Back to the cover
            </a>
            <a
              href="/portfolio"
              class="mono-label inline-flex items-center border-2 border-foreground px-6 py-3.5 text-foreground transition-colors duration-200 hover:border-accent hover:text-accent"
            >
              See the work
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
