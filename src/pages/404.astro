---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="404 — Page not found"
  description="The page you are looking for does not exist."
>
  <main class="flex flex-1 items-center justify-center">
    <div class="mx-auto max-w-6xl px-6 py-24 text-center">
      <p class="text-8xl font-bold tracking-tight text-foreground md:text-9xl">
        404
      </p>
      <p class="mt-4 text-lg text-muted-foreground">Page not found</p>
      <a
        href="/"
        class="mt-8 inline-flex items-center bg-accent px-6 py-3 text-sm font-semibold text-white transition-colors duration-200 hover:opacity-90"
      >
        Back home
      </a>
    </div>
  </main>
</BaseLayout>
