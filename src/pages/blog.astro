---
import { getCollection } from 'astro:content'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import BaseLayout from '../layouts/BaseLayout.astro'

const posts = (await getCollection('writing')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })
---

<BaseLayout
  title="Writing · Musa Yohanes"
  description="Articles by Musa Yohanes on data analysis and automation, published on Medium."
>
  <Header />
  <main id="main" class="flex-1">
    <section>
      <div class="mx-auto max-w-[1240px] px-6 py-16 md:py-20">
        <div class="section-head">
          <span class="font-mono text-sm font-semibold text-accent">00</span>
          <h1 class="text-3xl font-semibold tracking-tight text-foreground md:text-4xl">
            Application notes
          </h1>
        </div>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-secondary">
          The long-form version of the work: data analysis and automation,
          written up as I go. The same pieces live on Medium; these copies
          stay here.
        </p>
        <ul class="mt-12 divide-y divide-border border-y border-border">
          {
            posts.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`} class="group block py-7">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                    <h2 class="text-lg font-medium tracking-tight text-foreground transition-colors duration-200 group-hover:text-accent">
                      {post.data.title}
                    </h2>
                    <time
                      datetime={post.data.pubDate.toISOString()}
                      class="font-mono text-xs text-secondary tabular-nums"
                    >
                      {formatDate(post.data.pubDate)}
                    </time>
                  </div>
                  <p class="mt-2 max-w-2xl text-[15px] leading-relaxed text-secondary">
                    {post.data.description}
                  </p>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-8 font-mono text-xs text-secondary">
          Full archive on{' '}
          <a
            href="https://medium.com/@musayohanes00"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-accent transition-colors duration-200 hover:text-accent-deep hover:underline"
          >
            Medium
          </a>
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
