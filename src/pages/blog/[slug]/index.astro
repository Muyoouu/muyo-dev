---
import { getCollection, render } from 'astro:content'
import Footer from '../../../components/Footer.astro'
import Header from '../../../components/Header.astro'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getPostNeighbors } from '../../../lib/writing'

export async function getStaticPaths() {
  const posts = await getCollection('writing')
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
const { newer, older } = getPostNeighbors(await getCollection('writing'), post.id)

const { title, description, pubDate, url, tags } = post.data

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: pubDate.toISOString(),
  author: {
    '@type': 'Person',
    name: 'Musa Yohanes',
    url: Astro.site?.toString() ?? 'https://muyo.dev/',
  },
  isBasedOn: url,
  keywords: tags.join(', '),
  mainEntityOfPage: new URL(`/blog/${post.id}/`, Astro.site ?? 'https://muyo.dev').toString(),
}
---

<BaseLayout
  title={`${title} · Musa Yohanes`}
  description={description}
  ogType="article"
  publishedTime={pubDate}
  jsonLd={jsonLd}
>
  <Header />
  <main id="main" class="flex-1">
    <article>
      <div class="mx-auto max-w-3xl px-6 py-16 md:py-20">
        <a
          href="/blog"
          class="mono-label text-secondary transition-colors duration-200 hover:text-accent"
        >
          &larr; Application notes
        </a>
        <h1 class="mt-6 text-3xl font-semibold tracking-tight text-foreground md:text-4xl">
          {title}
        </h1>
        <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 border-y-2 border-foreground py-4 font-mono text-xs text-secondary">
          <time datetime={pubDate.toISOString()} class="tabular-nums">{formatDate(pubDate)}</time>
          <span aria-hidden="true">&middot;</span>
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-accent transition-colors duration-200 hover:text-accent-deep hover:underline"
          >
            Read on Medium
          </a>
        </div>
        {
          tags.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <li class="mono-label border border-border px-2 py-1 text-[0.625rem] text-secondary">
                  {tag}
                </li>
              ))}
            </ul>
          )
        }
        <div
          class="prose mt-10 max-w-none
            prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-foreground
            prose-p:text-secondary prose-p:leading-relaxed
            prose-a:font-medium prose-a:text-accent prose-a:no-underline hover:prose-a:underline
            prose-strong:font-medium prose-strong:text-foreground
            prose-inline-code:bg-muted prose-inline-code:px-1 prose-inline-code:py-0.5 prose-inline-code:font-normal prose-inline-code:text-foreground prose-inline-code:before:content-none prose-inline-code:after:content-none
            prose-pre:border-2 prose-pre:border-foreground prose-pre:rounded-none
            prose-blockquote:border-l-2 prose-blockquote:border-l-accent prose-blockquote:font-normal prose-blockquote:italic prose-blockquote:text-foreground
            prose-img:border-2 prose-img:border-foreground
            prose-hr:border-border"
        >
          <Content />
        </div>
        <div class="mt-12 border-t-2 border-foreground">
          <nav
            aria-label="Post navigation"
            class="flex flex-col divide-y divide-border md:flex-row md:divide-x md:divide-y-0"
          >
            {
              older && (
                <a
                  href={`/blog/${older.id}/`}
                  rel="prev"
                  class="group min-w-0 flex-1 py-6 transition-colors duration-200 md:pr-8"
                >
                  <span class="mono-label text-secondary">Older</span>
                  <span class="mt-2 block text-lg font-medium tracking-tight text-foreground transition-colors duration-200 group-hover:text-accent">
                    {older.data.title}
                  </span>
                  <span class="mt-1 block font-mono text-xs text-secondary tabular-nums">
                    {formatDate(older.data.pubDate)}
                  </span>
                </a>
              )
            }
            {
              newer && (
                <a
                  href={`/blog/${newer.id}/`}
                  rel="next"
                  class={`group min-w-0 flex-1 py-6 transition-colors duration-200 ${older ? 'md:pl-8 md:text-right' : ''}`}
                >
                  <span class="mono-label text-secondary">Newer</span>
                  <span class="mt-2 block text-lg font-medium tracking-tight text-foreground transition-colors duration-200 group-hover:text-accent">
                    {newer.data.title}
                  </span>
                  <span class="mt-1 block font-mono text-xs text-secondary tabular-nums">
                    {formatDate(newer.data.pubDate)}
                  </span>
                </a>
              )
            }
          </nav>
          <div class="flex flex-wrap items-center justify-between gap-x-8 border-t border-border">
            <a
              href="/blog"
              class="mono-label inline-flex min-h-11 items-center text-secondary transition-colors duration-200 hover:text-accent"
            >
              Application notes
            </a>
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="mono-label inline-flex min-h-11 items-center text-accent transition-colors duration-200 hover:text-accent-deep hover:underline"
            >
              Continue on Medium
            </a>
          </div>
        </div>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
