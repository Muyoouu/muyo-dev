---
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { profile } from '../data/profile'
import BaseLayout from '../layouts/BaseLayout.astro'

const { name, role, location, summary, experience, education, certifications, socials } = profile

const socialLinks = [
  { href: socials.github, label: 'GitHub' },
  { href: socials.linkedin, label: 'LinkedIn' },
  { href: socials.medium, label: 'Medium' },
  { href: socials.youtube, label: 'YouTube' },
]
---

<BaseLayout
  title="About · Musa Yohanes"
  description={`About ${name}, ${role.toLowerCase()} in ${location}. Former financial auditor at PwC and accounting lecturer, now building SaaS and workflow automation.`}
>
  <Header />
  <main class="flex-1">
    <section class="border-b-2 border-foreground">
      <div class="mx-auto max-w-[1240px] px-6 py-16 md:py-20">
        <div class="section-head">
          <span class="font-mono text-sm font-semibold text-accent">00</span>
          <h1 class="text-3xl font-semibold tracking-tight text-foreground md:text-4xl">
            The operator
          </h1>
        </div>
        <div class="mt-10 grid gap-12 md:grid-cols-3">
          <div class="md:col-span-2">
            <p class="text-lg leading-relaxed text-foreground md:text-xl">{summary}</p>
            <p class="mt-6 leading-relaxed text-secondary">
              I'm in {location}, working remote for a Dutch SaaS company. I got
              here through PwC audit rooms and accounting classrooms. That's
              why the tools I build come with clear process and numbers you can
              trust.
            </p>
          </div>
          <aside class="space-y-6 text-sm">
            <div class="border-t border-border pt-4">
              <h2 class="mono-label text-secondary">Location</h2>
              <p class="mt-2 text-[15px] text-foreground">{location}</p>
            </div>
            <div class="border-t border-border pt-4">
              <h2 class="mono-label text-secondary">Currently</h2>
              <p class="mt-2 text-[15px] text-foreground">
                {role} at {experience.at(0)?.company ?? 'Automation Boutique'}
              </p>
            </div>
            <div class="border-t border-border pt-4">
              <h2 class="mono-label text-secondary">Elsewhere</h2>
              <ul class="mt-2 space-y-1">
                {
                  socialLinks.map((social) => (
                    <li>
                      <a
                        href={social.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[15px] font-medium text-foreground transition-colors duration-200 hover:text-accent"
                      >
                        {social.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- Service history -->
    <section class="mx-auto max-w-[1240px] px-6 py-16 md:py-20">
      <div class="section-head">
        <span class="font-mono text-sm font-semibold text-accent">01</span>
        <h2 class="text-2xl font-semibold tracking-tight text-foreground md:text-3xl">
          Service history
        </h2>
      </div>
      <ol class="mt-10 divide-y divide-border border-y border-border">
        {
          experience.map((job) => (
            <li class="py-7" data-reveal>
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <h3 class="text-lg font-medium tracking-tight text-foreground">
                  {job.role} &middot; {job.company}
                </h3>
                <p class="font-mono text-xs text-secondary tabular-nums">{job.period}</p>
              </div>
              {job.location && <p class="mt-1 text-sm text-secondary">{job.location}</p>}
              <ul class="mt-3 space-y-1.5">
                {job.points.map((point) => (
                  <li class="text-[15px] leading-relaxed text-secondary">{point}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Education + certifications -->
    <section class="border-t-2 border-foreground">
      <div class="mx-auto grid max-w-[1240px] gap-12 px-6 py-16 md:grid-cols-2 md:py-20">
        <div>
          <div class="section-head border-t-0 pt-0">
            <span class="font-mono text-sm font-semibold text-accent">02</span>
            <h2 class="text-2xl font-semibold tracking-tight text-foreground md:text-3xl">
              Education
            </h2>
          </div>
          <ul class="mt-8 divide-y divide-border border-y border-border">
            {
              education.map((edu) => (
                <li class="py-5">
                  <h3 class="font-medium text-foreground">{edu.school}</h3>
                  <p class="mt-1 text-sm text-secondary">{edu.degree}</p>
                  <p class="mt-0.5 font-mono text-xs text-secondary tabular-nums">{edu.period}</p>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <div class="section-head border-t-0 pt-0">
            <span class="font-mono text-sm font-semibold text-accent">03</span>
            <h2 class="text-2xl font-semibold tracking-tight text-foreground md:text-3xl">
              Certifications
            </h2>
          </div>
          <ul class="mt-8 divide-y divide-border border-y border-border">
            {
              certifications.map((cert) => (
                <li class="py-4 text-[15px] font-medium text-foreground">{cert}</li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
