---
import '../styles/global.css'
import barlow400 from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url'
import barlow600 from '@fontsource/barlow/files/barlow-latin-600-normal.woff2?url'

const preloadFonts = [barlow400, barlow600] as const

interface Props {
  title: string
  description: string
  ogType?: 'website' | 'article'
  publishedTime?: Date
  image?: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const { title, description, ogType = 'website', publishedTime, image, jsonLd } = Astro.props

const site = Astro.site ?? new URL('https://muyo.dev')
const canonicalURL = new URL(Astro.url.pathname, site)
const socialImageURL = image ? new URL(image, site) : new URL('/og.png', site)
const siteName = 'Musa Yohanes'

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteName,
  url: site.toString(),
  jobTitle: 'Software Developer',
  description:
    'Software developer in Jakarta. Builds data platforms for treasury teams at a SaaS company. Former financial auditor at PwC.',
  sameAs: [
    'https://www.linkedin.com/in/musayohanes',
    'https://github.com/Muyoouu',
    'https://medium.com/@musayohanes00',
  ],
  knowsAbout: [
    'Python',
    'React',
    'TypeScript',
    'Data Pipelines',
    'Financial Systems',
    'Data Analysis',
  ],
}

const jsonLdBlocks = [personJsonLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])]
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {preloadFonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteName} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />

    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f1418" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    {jsonLdBlocks.map((block) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("muyo-theme");
        } catch (e) {
          stored = null;
        }
        var theme = "light";
        if (stored === "dark" || stored === "light") {
          theme = stored;
        }
        document.documentElement.setAttribute("data-theme", theme);
        var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!reduced) {
          document.documentElement.classList.add("js-reveal");
        }
      })();
    </script>
  </head>
  <body>
    <!--
      DIRECTION CONTRACT — Component Datasheet (seed a529239b, assigned direction, code-led)
      THESIS: The portfolio printed as the datasheet for a human component: part number, features,
      absolute maximum ratings, pinout, application notes. It refuses the centered-hero-plus-card
      dev-portfolio default and every warm cream ground; the light sheet is crisp white.
      OWN-WORLD: white #ffffff stock, cool ink #14171c, signal red #c8102e as the single accent,
      hairlines #cdd3db, table shade #f2f4f7, secondary #545e6b. Barlow 400-600 for type, JetBrains
      Mono for part numbers, dates, figures, and uppercase labels. Radius zero everywhere; 2px
      drawing frames and 1px table rules carry the depth; no soft shadows.
      STORY: A hiring manager reads the rating table and the application cards and gets it in
      seconds: this person audited financials at PwC, now builds the data systems finance runs on.
      They flip a package or make contact.
      FIRST VIEWPORT: A sticky title-block header (name and part number left, nav cells divided by
      rules, filled EMAIL cell right). Beneath, a 2px drawing frame: its top row is the sheet's
      title block (TITLE / DRAWN BY / LOCATION / REV cells), left column "FEATURES" holds the
      statement and the filled SEE THE WORK action, right column holds the ABSOLUTE MAXIMUM
      RATINGS table with real entries only.
      SIGNATURE INTERACTION: the package flip. Project cards are component packages; on hover or
      focus the card flips 180 degrees to its rear spec label (role, stack pins, date, links). One
      decisive motion, gated behind no-reduced-motion; the front always carries the essentials.
      FORM: component-datasheet, assigned index 7 of the grounded list, seed key a529239b.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the
      verdict, DESIGN.md, and every shipping raster carrying its provenance.
    -->
    <slot />
    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      const targets = document.querySelectorAll('[data-reveal]')
      if (reduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.setAttribute('data-revealed', ''))
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.setAttribute('data-revealed', '')
                io.unobserve(entry.target)
              }
            }
          },
          { threshold: 0.12 },
        )
        targets.forEach((el) => io.observe(el))
      }
    </script>
    <style is:global>
      html.js-reveal [data-reveal] {
        opacity: 0.001;
        transform: translateY(20px);
        transition:
          opacity 0.7s cubic-bezier(0.165, 0.84, 0.44, 1),
          transform 0.7s cubic-bezier(0.165, 0.84, 0.44, 1);
      }
      html.js-reveal [data-reveal="flip"] {
        transform: perspective(1200px) rotateX(-8deg) translateY(20px);
        transform-origin: center top;
      }
      html.js-reveal [data-reveal][data-revealed] {
        opacity: 1;
        transform: none;
      }
      @media (prefers-reduced-motion: reduce) {
        html.js-reveal [data-reveal] {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
  </body>
</html>
