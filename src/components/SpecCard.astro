---
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
  featured?: boolean
}

const { project, featured = false } = Astro.props

const { title, description, tags, role, date, url, repo, demo } = project.data

const links = [
  ...(repo ? [{ href: repo, label: 'Source' }] : []),
  ...(demo ? [{ href: demo, label: 'Demo' }] : []),
  ...(url ? [{ href: url, label: 'Article' }] : []),
]

const dateLabel = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })
---

<article class="package group" data-reveal={featured ? 'flip' : ''}>
  <div class="package-inner">
    <!-- Front face: essentials -->
    <div class="package-face package-front flex h-full flex-col border-2 border-foreground bg-card">
      <div class="flex items-center justify-between gap-4 border-b border-border bg-muted px-5 py-2.5">
        <span class="mono-label text-secondary">Component</span>
        <time datetime={date.toISOString()} class="font-mono text-xs text-secondary tabular-nums">
          {dateLabel}
        </time>
      </div>
      <div class="flex flex-1 flex-col p-5">
        <h3 class="text-xl font-semibold leading-snug tracking-tight text-foreground">
          <a href={`/projects/${project.id}/`} class="transition-colors duration-200 group-hover:text-accent">
            {title}
          </a>
        </h3>
        <p class="mt-2 flex-1 text-[15px] leading-relaxed text-secondary">
          {description}
        </p>
        <div class="mt-4 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="mono-label border border-border px-2 py-1 text-[0.625rem] text-secondary">
              {tag}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Rear face: the spec label -->
    <div class="package-face package-rear absolute inset-0 flex flex-col border-2 border-accent bg-card [transform:rotateY(180deg)]">
      <div class="flex items-center justify-between border-b border-border bg-accent-fill px-5 py-2.5">
        <span class="mono-label text-white">Spec</span>
        <span class="font-mono text-xs text-white tabular-nums">{dateLabel}</span>
      </div>
      <dl class="flex-1 divide-y divide-border px-5 text-sm">
        <div class="flex items-baseline justify-between gap-4 py-3">
          <dt class="mono-label text-secondary">Role</dt>
          <dd class="text-right font-medium text-foreground">{role ?? 'Developer'}</dd>
        </div>
        <div class="flex items-baseline justify-between gap-4 py-3">
          <dt class="mono-label text-secondary">Stack</dt>
          <dd class="text-right font-mono text-[13px] leading-snug text-foreground">
            {tags.join(' · ')}
          </dd>
        </div>
      </dl>
      <div class="flex flex-wrap gap-2 border-t border-border p-5 pt-4">
        <a
          href={`/projects/${project.id}/`}
          class="mono-label bg-accent-fill px-4 py-2 text-white transition-colors duration-200 hover:bg-accent-fill-hover"
        >
          Full datasheet
        </a>
        {
          links.slice(0, 2).map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mono-label border border-border px-4 py-2 text-foreground transition-colors duration-200 hover:border-accent hover:text-accent"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</article>

<style>
  .package {
    perspective: 1400px;
  }

  .package-inner {
    position: relative;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.55s var(--ease-sheet);
  }

  .package-face {
    backface-visibility: hidden;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .package:hover .package-inner {
      transform: rotateY(180deg);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .package:focus-within .package-inner {
      transform: rotateY(180deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .package-inner {
      transition: none;
    }

    .package-rear {
      display: none;
    }
  }
</style>
