---
const year = new Date().getFullYear()

const socials = [
  {
    href: 'https://github.com/Muyoouu',
    label: 'GitHub',
  },
  {
    href: 'https://www.linkedin.com/in/musayohanes',
    label: 'LinkedIn',
  },
  {
    href: 'https://medium.com/@musayohanes00',
    label: 'Medium',
  },
  {
    href: 'https://www.youtube.com/@DataDrivenDuck',
    label: 'YouTube',
  },
  {
    href: 'mailto:musayohanes00@gmail.com',
    label: 'Email',
  },
]
---

<footer class="border-t-2 border-foreground">
  <div
    class="mx-auto flex max-w-[1240px] flex-col justify-between gap-6 px-6 py-10 sm:flex-row sm:items-end"
  >
    <div>
      <p class="text-[15px] font-semibold uppercase tracking-tight text-foreground">Musa Yohanes</p>
      <p class="mt-1.5 font-mono text-xs text-secondary">
        &copy; {year} &middot; Jakarta, Indonesia &middot; Doc No. MY-WEB-01 &middot; Status: live
      </p>
    </div>

    <nav aria-label="Social links">
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                target={social.href.startsWith('mailto:') ? undefined : '_blank'}
                rel={social.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                class="mono-label text-secondary transition-colors duration-200 hover:text-accent"
              >
                {social.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
