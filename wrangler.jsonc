{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muyo-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/about",
      "/about/",
      "/blog",
      "/blog/*",
      "/portfolio",
      "/portfolio/",
      "/projects/*",
      "!/*.md"
    ]
  }
}
